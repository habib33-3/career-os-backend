model Source {
    id          String  @id @default(cuid())
    name        String
    url         String
    description String?
    logoUrl     String?

    userId String
    user   User   @relation(fields: [userId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    jobApplications JobApplication[]

    @@unique([userId, name])
    @@unique([userId, url])
    @@index([userId])
}
